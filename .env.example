# Copy to .env, replace SETUP_SECRET using: openssl rand -hex 32
APP_NAME=Migraine Tracker
APP_ORIGIN=https://migraine.example.com
SETUP_SECRET=replace-with-at-least-32-random-characters
DEFAULT_TIMEZONE=Australia/Sydney
COOKIE_SECURE=true
LOCAL_AUTH_ENABLED=true
# Comma-separated trusted reverse proxy IPs/CIDRs. Empty = trust none.
TRUSTED_PROXIES=
LOG_LEVEL=info
PORT=3000
DATA_DIR=/app-data
BACKUP_RETENTION_DAYS=30
# Uncomment to keep scheduled backups enabled during startup and upgrades.
# COMPOSE_PROFILES=backups
# Optional image override; normally use the release pinned in docker-compose.yml.
# MIGRAINE_IMAGE=migraine-tracker:local
# Docker binds localhost by default. Use a shared Docker network for container proxies.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Exact immutable subject belonging to the single owner (Authentik sub claim).
OIDC_ALLOWED_SUBJECT=
